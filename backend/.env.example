# LLMプロバイダの切り替え
# - auto: GEMINI_API_KEY があれば Gemini、なければ OLLAMA_MODEL、最後に fallback
# - gemini: Gemini を強制使用
# - ollama: Ollama を強制使用
# - anthropic: Claude（Anthropic API）を強制使用。学習者の文章が外部APIに送られる点に注意
# - fallback: ルールベース応答のみ
LLM_PROVIDER=auto

# Gemini設定
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Claude設定（キーはSDKが環境変数から読む）
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# Ollama設定
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=60

# フェーズ4のグループ別上書き（未設定なら上の共通設定を使用）
# 使用可能な接頭辞: GROUP_A / GROUP_B / GROUP_C / FACILITATOR
# 例: 3グループはOllama、司会だけGeminiにする
# GROUP_A_LLM_PROVIDER=ollama
# GROUP_A_LLM_MODEL=qwen2.5:7b-instruct
# GROUP_B_LLM_PROVIDER=ollama
# GROUP_B_LLM_MODEL=llama3.1:8b
# GROUP_C_LLM_PROVIDER=gemini
# GROUP_C_LLM_MODEL=gemini-2.5-flash
# FACILITATOR_LLM_PROVIDER=gemini
# FACILITATOR_LLM_MODEL=gemini-2.5-flash

# フェーズ4で1回に生成する最大トークン数（プロバイダー共通）
GROUP_MAX_TOKENS=140
FACILITATOR_MAX_TOKENS=160

